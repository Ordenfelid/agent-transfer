{
  "name": "agent-transfer",
  "version": "0.4.1",
  "type": "module",
  "description": "SiYuan agent tools: download a URL into workspace assets; upload assets to user-gated URLs (raw/multipart body, {{secrets}} headers); redacted debug log",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite build --watch",
    "build": "cross-env NODE_ENV=production vite build",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cross-env": "^10.1.0",
    "siyuan": "1.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4"
  }
}
